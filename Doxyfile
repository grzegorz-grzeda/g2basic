# Doxygen configuration for the G2Basic API reference.
#
# Run from the repository root:  doxygen Doxyfile
# or through CMake:              cmake --build build --target docs
#
# Only settings that differ from Doxygen's defaults are listed, so the file works
# with Doxygen 1.9.8 (Ubuntu 24.04) and later without upgrade warnings. Graph
# output requires Graphviz `dot` on PATH. The theme requires the submodule:
#   git submodule update --init external/doxygen-awesome-css
# See docs/development.md#api-documentation.

#---------------------------------------------------------------------------
# Project
#---------------------------------------------------------------------------
PROJECT_NAME           = G2Basic
PROJECT_BRIEF          = "BASIC interpreter for microcontrollers"
# Set G2BASIC_DOCS_VERSION to show a version; CI passes the project() version
# and commit, and the CMake docs target passes the project() version.
PROJECT_NUMBER         = $(G2BASIC_DOCS_VERSION)
# Doxygen creates only the last directory level of each path, so the output
# location is split in two: it creates build/ on a fresh clone, then docs/.
OUTPUT_DIRECTORY       = build
HTML_OUTPUT            = docs
CREATE_SUBDIRS         = NO

#---------------------------------------------------------------------------
# Language and extraction
#---------------------------------------------------------------------------
OPTIMIZE_OUTPUT_FOR_C  = YES
JAVADOC_AUTOBRIEF      = YES
FULL_PATH_NAMES        = YES
STRIP_FROM_PATH        = .
# Show includes as "g2basic.h", matching the library's public include directory.
STRIP_FROM_INC_PATH    = src
MARKDOWN_SUPPORT       = YES
TOC_INCLUDE_HEADINGS   = 3
EXTRACT_ALL            = NO
EXTRACT_STATIC         = NO
SORT_MEMBER_DOCS       = NO
SORT_GROUP_NAMES       = NO

#---------------------------------------------------------------------------
# Warnings: every declaration in the input headers must be documented.
#---------------------------------------------------------------------------
QUIET                  = YES
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = YES
WARN_NO_PARAMDOC       = YES
WARN_AS_ERROR          = FAIL_ON_WARNINGS

#---------------------------------------------------------------------------
# Input: headers, the group hierarchy and main page, and the example program.
#---------------------------------------------------------------------------
# Headers first, so the public API group precedes the internal one in the tree.
INPUT                  = src \
                         docs/doxygen
FILE_PATTERNS          = *.h \
                         *.dox
RECURSIVE              = YES
EXAMPLE_PATH           = examples
EXAMPLE_RECURSIVE      = YES

#---------------------------------------------------------------------------
# Preprocessor
#---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
INCLUDE_PATH           = src

#---------------------------------------------------------------------------
# Output
#---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_TREEVIEW      = YES
DISABLE_INDEX          = NO
FULL_SIDEBAR           = NO
GENERATE_LATEX         = NO

#---------------------------------------------------------------------------
# Theme: doxygen-awesome-css (submodule, pinned) with a dark-mode toggle and a
# teal palette shared with HomeCore. The theme requires HTML_COLORSTYLE = LIGHT;
# it provides dark mode itself and inverts Graphviz graphs to match.
#---------------------------------------------------------------------------
HTML_COLORSTYLE        = LIGHT
HTML_HEADER            = docs/doxygen/header.html
HTML_EXTRA_STYLESHEET  = external/doxygen-awesome-css/doxygen-awesome.css \
                         docs/doxygen/g2basic.css
HTML_EXTRA_FILES       = external/doxygen-awesome-css/doxygen-awesome-darkmode-toggle.js

#---------------------------------------------------------------------------
# Graphviz diagrams
#---------------------------------------------------------------------------
HAVE_DOT               = YES
DOT_IMAGE_FORMAT       = svg
INTERACTIVE_SVG        = YES
DOT_MULTI_TARGETS      = YES
# Header dependency graphs in both directions.
INCLUDE_GRAPH          = YES
INCLUDED_BY_GRAPH      = YES
# Relationships between the groups.
GROUP_GRAPHS           = YES
DIRECTORY_GRAPH        = YES
# The input contains declarations only, so call graphs would be empty.
CALL_GRAPH             = NO
CALLER_GRAPH           = NO
